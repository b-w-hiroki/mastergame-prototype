{
  "expo": {
    "name": "MasterGame",
    "slug": "mastergame",
    "scheme": "mastergame",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#0c0e16" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.criticalhit.mastergame",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "提携先で達成したミッションを正しくあなたのアカウントに反映し、ポイントをお渡しするために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "jp.criticalhit.mastergame",
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "MasterGame",
      "shortName": "MasterGame",
      "lang": "ja",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "themeColor": "#0c0e16",
      "backgroundColor": "#0c0e16",
      "description": "ポイ活 × ゲームコミュニティ。遊ぶほど得をする。"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#4f46e5" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
