# ============================================================
# MasterGame — 環境変数の一覧（各アプリの .env.example も参照）
# 本番値はコミットしないこと。Supabase ダッシュボード → Project Settings → API
# ============================================================

# ---- Supabase（共通） ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # 秘匿。サーバー専用

# ---- モバイル（apps/mobile/.env） ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- 管理画面（apps/admin/.env.local） ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SUPABASE_SERVICE_ROLE_KEY は上記を再利用（サーバー専用）

# ---- Edge Function: postback（supabase secrets set で設定） ----
# パートナーslugごと（無ければ共通 POSTBACK_SECRET）。SUPABASE_URL/SERVICE_ROLE は自動注入
POSTBACK_SECRET=shared-secret
POSTBACK_SECRET_APPLOVIN=applovin-secret
POSTBACK_SECRET_TAPJOY=tapjoy-secret
POSTBACK_SECRET_IRONSOURCE=ironsource-secret

# ---- OAuth（Supabase Auth プロバイダ設定で使用） ----
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
